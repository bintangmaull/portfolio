---
import Layout from "../layouts/Layout.astro";
import ProductCatalog from "../components/ProductCatalog.tsx";
import { personal, contact } from "../data/portfolio";
---

<Layout
  title="Geospatial Products & Services — Bintang Maulana Magribi"
  description="Explore interactive WebGIS templates, AI geospatial automation tools, and professional geodetic & UAV surveying services by Bintang Maulana Magribi."
  canonicalUrl="https://bintangmaulana.com/product"
>
  <!-- Navbar -->
  <nav id="navbar" class="fixed top-0 w-full z-50 transition-all duration-500 py-4 px-8 bg-[#0A0E1A]/80 backdrop-blur-md border-b border-[#1E2D45]">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="/" class="font-display font-bold text-base dark:text-brand-white text-light-heading tracking-tight px-3 py-1.5 border border-brand-border rounded-sm hover:border-brand-blue transition-colors">
        Bintang<span class="text-brand-blue">.</span>
      </a>
      <ul class="hidden md:flex gap-8 font-body text-sm dark:text-brand-text/80 text-light-text/80">
        <li><a href="/" class="hover:text-brand-blue transition-colors">Home</a></li>
        <li><a href="/product" class="text-brand-blue font-semibold">Products & Services</a></li>
        <li><a href="/#about" class="hover:text-brand-blue transition-colors">About</a></li>
        <li><a href="/#experience" class="hover:text-brand-blue transition-colors">Experience</a></li>
        <li><a href="/#contact" class="hover:text-brand-blue transition-colors">Contact</a></li>
      </ul>
      <div class="flex items-center gap-3">
        <a
          href="https://wa.me/6282135839218?text=Halo%20Bintang,%20saya%20tertarik%20konsultasi%20layanan%20geospasial%20/%20produk%20WebGIS."
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-block font-mono text-xs border border-brand-blue text-brand-blue hover:bg-brand-blue hover:text-white px-4 py-2 transition-all duration-300"
        >
          QUICK CONSULT →
        </a>
        <button id="theme-toggle" class="p-2 rounded-full hover:dark:bg-brand-surface hover:bg-light-border/50 transition-all" aria-label="Toggle theme">
          <svg id="icon-moon" class="w-4 h-4 dark:text-brand-text/60 text-light-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display:block;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
          <svg id="icon-sun" class="w-4 h-4 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display:none;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative pt-36 pb-20 px-8 overflow-hidden">
    <!-- Subtle Grid Background -->
    <div class="absolute inset-0 top-pattern opacity-30 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10">
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 font-mono text-xs text-[#06B6D4] mb-6">
        <a href="/" class="hover:underline">HOME</a>
        <span>/</span>
        <span class="text-brand-blue">PRODUCTS & SERVICES</span>
      </div>

      <!-- Main Header -->
      <div class="max-w-3xl">
        <span class="inline-block font-mono text-xs text-brand-blue border border-brand-blue/30 bg-brand-blue/10 px-3 py-1 mb-4">
          CURATED PORTFOLIO & PROFESSIONAL SERVICES
        </span>
        <h1 class="font-display font-extrabold text-4xl sm:text-5xl md:text-6xl dark:text-white text-gray-900 tracking-tight leading-none mb-6">
          Digital Products, <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#2563EB] via-[#06B6D4] to-[#2563EB]">
            Tools & Specialized Services.
          </span>
        </h1>
        <p class="font-body text-base sm:text-lg dark:text-gray-300 text-gray-700 leading-relaxed mb-10">
          Explore our curated collection of production-ready web applications, automation toolkits, and professional engineering services tailored to accelerate your projects with precision, reliability, and scale.
        </p>
      </div>

      <!-- Interactive React Product Catalog -->
      <ProductCatalog client:load />
    </div>
  </section>

  <!-- Consultation Banner Section -->
  <section class="py-20 px-8 border-t border-[#1E2D45] dark:bg-[#111827]/30 bg-gray-50">
    <div class="max-w-4xl mx-auto text-center">
      <span class="font-mono text-xs text-[#06B6D4] tracking-widest uppercase mb-3 block">
        NEED A TAILORED SOLUTION FOR YOUR PROJECT?
      </span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl dark:text-white text-gray-900 mb-4">
        Let’s Build Something Exceptional Together.
      </h2>
      <p class="font-body text-sm sm:text-base dark:text-gray-400 text-gray-600 mb-8 max-w-2xl mx-auto leading-relaxed">
        Whether you require custom web platforms, automated data processing pipelines, or specialized engineering consulting — get in touch to discuss how we can turn your vision into reality.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="https://wa.me/6282135839218?text=Halo%20Bintang,%20saya%20ingin%20berdiskusi%20mengenai%20layanan%20dan%20solusi%20geospasial."
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs bg-[#2563EB] hover:bg-[#06B6D4] text-white px-8 py-3.5 transition-colors shadow-lg shadow-[#2563EB]/25"
        >
          CHAT ON WHATSAPP →
        </a>
        <a
          href="mailto:bintang1350@gmail.com?subject=Consultation%20Inquiry%20-%20Geospatial%20Services"
          class="font-mono text-xs border border-[#1E2D45] dark:text-white text-gray-800 hover:border-[#06B6D4] px-8 py-3.5 transition-colors"
        >
          SEND AN EMAIL
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-[#1E2D45] py-8 px-8 dark:bg-[#0A0E1A] bg-white">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-mono dark:text-gray-500 text-gray-600">
      <div>
        © {new Date().getFullYear()} Bintang Maulana Magribi. Built with Astro & React.
      </div>
      <div class="flex gap-6">
        <a href="/" class="hover:text-[#06B6D4] transition-colors">Home</a>
        <a href="/product" class="hover:text-[#06B6D4] transition-colors">Products</a>
        <a href="https://linkedin.com/in/bintangmaulana/" target="_blank" rel="noopener noreferrer" class="hover:text-[#06B6D4] transition-colors">LinkedIn</a>
        <a href="https://github.com/bintangmaull" target="_blank" rel="noopener noreferrer" class="hover:text-[#06B6D4] transition-colors">GitHub</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    // Theme toggle script for product page
    const themeToggleBtn = document.getElementById('theme-toggle');
    const moonIcon = document.getElementById('icon-moon');
    const sunIcon = document.getElementById('icon-sun');

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (moonIcon && sunIcon) {
        moonIcon.style.display = isDark ? 'block' : 'none';
        sunIcon.style.display = isDark ? 'none' : 'block';
      }
    }
    updateIcons();

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateIcons();
      });
    }
  </script>
</Layout>
