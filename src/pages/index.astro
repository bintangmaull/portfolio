---
import Layout from "../layouts/Layout.astro";
import ExperienceSection from "../components/ExperienceSection.tsx";
import { personal, education, stats, specializations, projects, organizations, contact } from "../data/portfolio";
---

<Layout>

  <!-- Navbar -->
  <nav id="navbar" class="fixed top-0 w-full z-50 transition-all duration-500 py-4 px-8">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="#" class="font-display font-bold text-base dark:text-brand-white text-light-heading tracking-tight px-3 py-1.5 border border-brand-border rounded-sm">
        Bintang<span class="text-brand-blue">.</span>
      </a>
      <ul class="hidden md:flex gap-8 font-body text-sm dark:text-brand-text/60 text-light-text/70">
        <li><a href="#about" class="nav-link hover:text-brand-blue transition-colors" data-section="about">About</a></li>
        <li><a href="#skills" class="nav-link hover:text-brand-blue transition-colors" data-section="skills">Skills</a></li>
        <li><a href="#experience" class="nav-link hover:text-brand-blue transition-colors" data-section="experience">Experience</a></li>
        <li><a href="#projects" class="nav-link hover:text-brand-blue transition-colors" data-section="projects">Projects</a></li>
        <li><a href="#contact" class="nav-link hover:text-brand-blue transition-colors" data-section="contact">Contact</a></li>
      </ul>
      <div class="flex items-center gap-3">
        <!-- Mobile hamburger -->
        <button id="mobile-toggle" class="md:hidden p-2 dark:text-brand-text text-light-text" aria-label="Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <button id="theme-toggle" class="p-2 rounded-full hover:dark:bg-brand-surface hover:bg-light-border/50 transition-all" aria-label="Toggle theme">
          <svg id="icon-moon" class="w-4 h-4 dark:text-brand-text/60 text-light-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display:block;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
          <svg id="icon-sun" class="w-4 h-4 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display:none;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </button>
      </div>
    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-brand-border pt-4">
      <ul class="flex flex-col gap-3 font-body text-sm dark:text-brand-text/70 text-light-text/70">
        <li><a href="#about" class="block py-2 hover:text-brand-blue transition-colors mobile-link">About</a></li>
        <li><a href="#skills" class="block py-2 hover:text-brand-blue transition-colors mobile-link">Skills</a></li>
        <li><a href="#experience" class="block py-2 hover:text-brand-blue transition-colors mobile-link">Experience</a></li>
        <li><a href="#projects" class="block py-2 hover:text-brand-blue transition-colors mobile-link">Projects</a></li>
        <li><a href="#contact" class="block py-2 hover:text-brand-blue transition-colors mobile-link">Contact</a></li>
      </ul>
    </div>
  </nav>

  <!-- Scroll Progress Bar -->
  <div id="scroll-progress" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-brand-blue to-brand-cyan z-[60] transition-none" style="width: 0%;"></div>

  <!-- Back to Top Button -->
  <button id="back-to-top" class="fixed bottom-6 right-6 z-40 w-10 h-10 bg-brand-blue text-white rounded-full flex items-center justify-center shadow-lg shadow-brand-blue/20 opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:bg-brand-cyan" aria-label="Back to top">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
    </svg>
  </button>

  <!-- ══════════════ HERO ══════════════ -->
  <section class="relative min-h-screen flex items-center overflow-hidden">
    <!-- Glow orbs -->
    <div class="absolute top-10 right-10 w-[500px] h-[500px] rounded-full pointer-events-none opacity-20"
         style="background: radial-gradient(circle, rgba(37,99,235,0.12) 0%, transparent 70%);"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-8 w-full py-24">
      <div class="grid lg:grid-cols-[45%_1fr] gap-10 items-start">
        
        <!-- Left: Text -->
        <div class="hero-stagger pt-8">
          <!-- Simple label -->
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-px bg-brand-cyan"></span>
            <span class="font-mono text-[11px] text-brand-cyan tracking-[0.2em]">GEODESY & GEOMATICS ENGINEER</span>
          </div>

          <!-- Name with typing animation -->
          <h1 class="font-display font-black text-[clamp(2.2rem,5vw,4rem)] leading-[1] tracking-tight dark:text-brand-white text-light-heading mb-5">
            <span id="typed-name"></span><span id="cursor" class="text-brand-blue">|</span>
          </h1>

          <!-- Bio -->
          <p class="font-body text-sm dark:text-brand-text/60 text-light-text/70 max-w-sm mb-8 leading-[1.8]">
            Geodesy and Geomatics Engineering graduate from ITB experienced in UAV surveying, GIS analysis, and WebGIS development. Proficient in spatial data processing tools (ArcGIS, QGIS, Agisoft, LiDAR) and programming (Python, PostGIS), combining strong technical expertise with excellent leadership and teamwork skills.
          </p>

          <!-- CTA -->
          <div class="flex gap-4 flex-wrap">
            <a href="#projects" class="group relative bg-brand-blue text-white font-mono text-xs px-7 py-3.5 tracking-wider overflow-hidden transition-all hover:shadow-[0_0_25px_rgba(37,99,235,0.3)]">
              <span class="relative z-10">VIEW PROJECTS</span>
              <div class="absolute inset-0 bg-brand-cyan translate-x-full group-hover:translate-x-0 transition-transform duration-500"></div>
            </a>
            <a href="#contact" class="border border-brand-border dark:text-brand-text/70 text-light-text font-mono text-xs px-7 py-3.5 tracking-wider hover:border-brand-blue hover:text-brand-blue transition-all">
              CONTACT ME
            </a>
          </div>
        </div>

        <!-- Right: Photo -->
        <div class="relative mt-8" data-tilt>
          <img src="/Gambar/Foto.jpeg" alt="Bintang Maulana Magribi"
               class="w-full aspect-[3/2] object-cover photo-glow rounded-sm" />
          <div class="flex justify-between items-center mt-3 mx-1">
            <span class="font-mono text-[10px] text-brand-cyan tracking-wider">ITB · 2025</span>
            <span class="font-mono text-[10px] dark:text-brand-muted text-light-muted italic">"Be the star wherever you are."</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
      <span class="font-mono text-[9px] dark:text-brand-muted/30 text-light-muted/50 tracking-[0.3em]">SCROLL</span>
      <div class="w-px h-8 bg-gradient-to-b from-brand-blue/40 to-transparent"></div>
    </div>
  </section>

  <!-- ══════════════ ABOUT ══════════════ -->
  <section id="about" class="py-28 relative">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-brand-blue/20 to-transparent"></div>
    <div class="max-w-7xl mx-auto px-8">
      <div class="grid lg:grid-cols-5 gap-16 items-start">
        <div class="lg:col-span-3" data-reveal>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-px bg-brand-cyan"></span>
            <span class="font-mono text-[11px] text-brand-cyan tracking-[0.2em]">ABOUT ME</span>
          </div>
          <h2 class="font-display font-bold text-3xl dark:text-brand-white text-light-heading mb-6 leading-tight">
            Mapping Indonesia,<br/><span class="text-brand-blue">one flight at a time.</span>
          </h2>
          
          <!-- Education with ITB logo -->
          <div data-tilt class="border border-brand-border dark:bg-brand-surface/50 bg-light-surface p-6 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-brand-blue"></div>
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="font-mono text-[10px] text-brand-cyan tracking-[0.2em] mb-2">EDUCATION</div>
                <div class="font-display font-semibold text-lg dark:text-brand-white text-light-heading">{education.institution}</div>
                <div class="font-body text-sm dark:text-brand-text/60 text-light-text mt-1">{education.major}</div>
                <div class="flex gap-6 mt-4">
                  <div>
                    <div class="font-mono text-xl font-bold dark:text-brand-white text-light-heading">{education.gpa}</div>
                    <div class="font-mono text-[10px] dark:text-brand-muted text-light-muted">GPA</div>
                  </div>
                  <div>
                    <div class="font-mono text-xl font-bold dark:text-brand-white text-light-heading">{education.period}</div>
                    <div class="font-mono text-[10px] dark:text-brand-muted text-light-muted">PERIOD</div>
                  </div>
                </div>
              </div>
              <img src="/Gambar/logoitb.webp" alt="Logo ITB" class="w-16 h-16 object-contain shrink-0 opacity-80" />
            </div>
          </div>
        </div>

        <!-- Right: Organizations as Roadmap -->
        <div class="lg:col-span-2" data-reveal>
          <div class="font-mono text-[10px] dark:text-brand-muted text-light-muted tracking-[0.2em] mb-8">ORGANIZATIONAL EXPERIENCE</div>
          
          <!-- Timeline roadmap with animation -->
          <div class="relative pl-8">
            <!-- Vertical line (animated grow) -->
            <div class="absolute left-[9px] top-2 bottom-2 w-0.5 rounded-full overflow-hidden">
              <div class="w-full h-full bg-gradient-to-b from-brand-blue via-brand-cyan to-brand-blue/20 origin-top" 
                   style="animation: growLine 1.5s ease-out 0.5s forwards; transform: scaleY(0);"></div>
            </div>
            
            {organizations.map((org, i) => (
              <div class="relative pb-10 last:pb-0" style={`animation: fadeSlideUp 0.6s ease ${0.8 + i * 0.3}s forwards; opacity: 0;`}>
                <!-- Dot with ring -->
                <div class="absolute left-[-23px] top-1">
                  <div class={`w-4 h-4 rounded-full border-2 flex items-center justify-center ${i === 0 ? 'border-brand-blue bg-brand-blue/20' : 'border-brand-cyan/50 dark:bg-brand-dark bg-light-bg'}`}>
                    <div class={`w-1.5 h-1.5 rounded-full ${i === 0 ? 'bg-brand-blue' : 'bg-brand-cyan/50'}`}></div>
                  </div>
                </div>
                <!-- Content card -->
                <div class="ml-4 dark:bg-brand-surface/30 bg-light-surface border border-brand-border p-4 rounded-sm hover:border-brand-blue/30 transition-all">
                  <div class="font-mono text-[10px] text-brand-cyan mb-1">{org.period}</div>
                  <div class="font-display font-semibold text-sm dark:text-brand-white text-light-heading">{org.name}</div>
                  <div class="font-body text-xs dark:text-brand-text/60 text-light-text mt-1">{org.role}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ SKILLS ══════════════ -->
  <section id="skills" class="py-28 relative">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-brand-border to-transparent"></div>
    <div class="max-w-7xl mx-auto px-8">
      <!-- Specializations -->
      <div class="flex items-center gap-3 mb-4" data-reveal>
        <span class="w-8 h-px bg-brand-cyan"></span>
        <span class="font-mono text-[11px] text-brand-cyan tracking-[0.2em]">SPECIALIZATIONS</span>
      </div>
      <h2 data-reveal class="font-display font-bold text-3xl dark:text-brand-white text-light-heading mb-12">Core Competencies</h2>

      <!-- Proficiency: Software logos - flowing marquee style -->
      <div data-reveal class="mb-20">
        <div class="font-mono text-[10px] dark:text-brand-muted text-light-muted tracking-[0.2em] mb-8">PROFICIENCY</div>
        
        <!-- Geodetic row -->
        <div class="mb-6">
          <h3 class="font-display font-semibold text-xs dark:text-brand-cyan text-brand-blue mb-3 uppercase tracking-wider">Geodetic</h3>
          <div class="flex flex-wrap gap-3">
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-blue/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/AgisoftMetashape.png" alt="Agisoft" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">Agisoft Metashape</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-blue/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/djiterra.png" alt="DJI Terra" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">DJI Terra</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-blue/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/trimblebusinesscenter.png" alt="Trimble" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">Trimble BC</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-blue/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/qgis.png" alt="QGIS" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">QGIS</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-blue/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/arcgis.webp" alt="ArcGIS" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">ArcGIS</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-blue/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/globalmapper.png" alt="Global Mapper" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">Global Mapper</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-blue/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/googleearthengine.png" alt="GEE" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">Google Earth Engine</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-blue/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/civil3d.svg" alt="Civil3D" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">AutoCAD Civil3D</span>
            </div>
          </div>
        </div>

        <!-- IT row -->
        <div class="mb-6">
          <h3 class="font-display font-semibold text-xs dark:text-brand-cyan text-brand-blue mb-3 uppercase tracking-wider">IT & Development</h3>
          <div class="flex flex-wrap gap-3">
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-cyan/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/python.png" alt="Python" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">Python</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-cyan/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/flask.png" alt="Flask" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">Flask</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-cyan/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/next.webp" alt="Next.js" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">Next.js</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-cyan/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/postgresql.png" alt="PostgreSQL" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">PostgreSQL</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-cyan/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/postgis.png" alt="PostGIS" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">PostGIS</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-[#162035] bg-white/90 border border-brand-border rounded-full hover:border-brand-cyan/50 hover:scale-105 transition-all shadow-sm">
              <img src="/Gambar/matlab.png" alt="Matlab" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">Matlab</span>
            </div>
          </div>
        </div>

        <!-- Creative row -->
        <div class="mb-6">
          <h3 class="font-display font-semibold text-xs dark:text-brand-cyan text-brand-blue mb-3 uppercase tracking-wider">Creative</h3>
          <div class="flex flex-wrap gap-3">
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-brand-surface/40 bg-light-surface border border-brand-border rounded-full hover:border-brand-blue/50 hover:scale-105 transition-all">
              <img src="/Gambar/adobe premiere pro.webp" alt="Premiere Pro" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">Premiere Pro</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-brand-surface/40 bg-light-surface border border-brand-border rounded-full hover:border-brand-blue/50 hover:scale-105 transition-all">
              <img src="/Gambar/canva.webp" alt="Canva" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">Canva</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 dark:bg-brand-surface/40 bg-light-surface border border-brand-border rounded-full hover:border-brand-blue/50 hover:scale-105 transition-all">
              <img src="/Gambar/adobe illustrator.png" alt="Illustrator" class="w-10 h-10 object-contain" />
              <span class="text-xs dark:text-brand-text/80 text-light-text font-medium">Illustrator</span>
            </div>
            <div class="flex items-center gap-3 px-5 py-3 border border-brand-border/40 border-dashed rounded-full dark:text-brand-muted text-light-muted">
              <span class="text-xs">+ And Others</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Specializations -->
      <div data-reveal class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 mb-16">
        {specializations.map((spec, i) => {
          const isEven = i % 2 === 0;
          return (
            <div data-tilt class="skill-card border border-brand-border dark:bg-brand-surface/30 bg-light-surface p-7 hover:border-brand-blue/50 overflow-hidden relative cursor-default">
              <div class="text-3xl mb-4">
                {spec.icon === 'plane' ? '✈️' : spec.icon === 'globe' ? '🌐' : spec.icon === 'map' ? '🗺️' : '🌊'}
              </div>
              <h3 class="font-display font-semibold text-sm dark:text-brand-white text-light-heading mb-2">{spec.name}</h3>
              <p class="font-body text-xs dark:text-brand-muted text-light-muted leading-relaxed">{spec.description}</p>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- ══════════════ EXPERIENCE ══════════════ -->
  <section id="experience" class="py-28 relative">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-brand-border to-transparent"></div>
    <div class="max-w-7xl mx-auto px-8">
      <div class="flex items-center gap-3 mb-4" data-reveal>
        <span class="w-8 h-px bg-brand-cyan"></span>
        <span class="font-mono text-[11px] text-brand-cyan tracking-[0.2em]">FIELD EXPERIENCE</span>
      </div>
      <h2 data-reveal class="font-display font-bold text-3xl dark:text-brand-white text-light-heading mb-12">Professional Experience</h2>
      <ExperienceSection client:visible />
    </div>
  </section>

  <!-- ══════════════ PROJECTS ══════════════ -->
  <section id="projects" class="py-28 relative">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-brand-blue/30 to-transparent"></div>
    <div class="max-w-7xl mx-auto px-8">
      <div class="flex items-center gap-3 mb-4" data-reveal>
        <span class="w-8 h-px bg-brand-cyan"></span>
        <span class="font-mono text-[11px] text-brand-cyan tracking-[0.2em]">DEVELOPMENT</span>
      </div>
      <h2 data-reveal class="font-display font-bold text-3xl dark:text-brand-white text-light-heading mb-12">Featured Projects</h2>

      <!-- Featured: Bali Catalyst -->
      <div data-reveal data-tilt class="grid lg:grid-cols-2 gap-10 items-center mb-16 border border-brand-border dark:bg-brand-surface/20 bg-light-surface p-8 hover:border-brand-blue/30 transition-all">
        <div>
          <span class="font-mono text-[10px] text-brand-blue tracking-wider">01 — FEATURED</span>
