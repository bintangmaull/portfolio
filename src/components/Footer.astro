---
import { personal } from "../data/portfolio";
---

<footer class="border-t border-[#2C2C2E] py-8 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-[#98989D] text-sm">
      © {new Date().getFullYear()} {personal.name}. Built with
      <span class="text-[#00E5FF]">Astro</span> &
      <span class="text-[#00E5FF]">Tailwind CSS</span>.
    </p>
    <p class="text-[#98989D]/50 text-xs mt-2 font-mono">
      WattVision Design System
    </p>
  </div>
</footer>
