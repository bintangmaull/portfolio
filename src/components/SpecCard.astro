---
interface Props {
  name: string;
  icon: string;
  description: string;
  delay?: number;
}

const { name, icon, description, delay = 0 } = Astro.props;
---

<div
  class="bg-[#1E1E1E] rounded-2xl p-6 border border-[#2C2C2E] hover:bg-[#252525] hover:border-[#00E5FF]/30 transition-all duration-300 group cursor-default"
  data-aos="fade-up"
  data-aos-delay={delay}
>
  <h3 class="font-semibold text-white text-base mb-2">{name}</h3>
  <p class="text-[#98989D] text-sm leading-relaxed">{description}</p>
</div>
