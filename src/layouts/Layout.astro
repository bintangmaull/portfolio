---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = "Bintang Maulana Magribi — Geodesy & Geomatics Engineer",
  description = "Portfolio of Bintang Maulana Magribi — Geodesy & Geomatics Engineer, UAV Drone Surveyor, GIS & WebGIS Developer graduate from ITB.",
  image = "/Gambar/Foto.jpeg",
  canonicalUrl = Astro.url.href
} = Astro.props;

const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Bintang Maulana Magribi",
  "alternateName": ["Bintang Maulana", "Bintang M. Magribi"],
  "jobTitle": "Foreman GIS & Aerial Survey — Geodesy and Geomatics Engineer",
  "worksFor": {
    "@type": "Organization",
    "name": "PT. Ganda Alam Makmur"
  },
  "description": description,
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "Institut Teknologi Bandung"
  },
  "knowsAbout": [
    "Geodesy",
    "Geomatics Engineering",
    "Photogrammetry",
    "LiDAR Processing",
    "WebGIS",
    "GIS Analysis",
    "UAV Surveying",
    "Hydrography"
  ],
  "sameAs": [
    "https://linkedin.com/in/bintangmaulana/"
  ]
});
---

<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Bintang Maulana Magribi, Bintang Maulana, Geodesy Engineer, Geomatics Engineer, UAV Surveyor, WebGIS Developer, ITB, GIS Specialist, Drone Surveyor Indonesia, Photogrammetry, LiDAR" />
  <meta name="author" content="Bintang Maulana Magribi" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="Bintang Maulana Magribi — Portfolio" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Schema.org Person JSON-LD -->
  <script type="application/ld+json" set:html={personSchema} />

  <!-- Non-blocking font loading: preconnect + print trick prevents render-blocking -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Sora:wght@300;400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap"
        media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Sora:wght@300;400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" />
  </noscript>

  <link rel="icon" type="image/png" href="/Gambar/favicon.png" />

  <!-- Prevent flash: apply saved theme before render -->
  <script is:inline>
    const theme = localStorage.getItem('theme') || 'dark';
    document.documentElement.classList.toggle('dark', theme === 'dark');
  </script>
</head>
<body class="font-body antialiased overflow-x-hidden transition-colors duration-300">

  <!-- Animated background: floating particles + parallax blobs -->
  <div id="bg-particles" class="fixed inset-0 pointer-events-none" style="z-index: -15;"></div>
  
  <!-- Parallax glow blobs -->
  <div data-parallax="0.08" class="fixed top-[10%] right-[15%] w-[400px] h-[400px] rounded-full pointer-events-none opacity-[0.12]"
       style="z-index: -18; background: radial-gradient(circle, #2563EB 0%, transparent 70%);"></div>
  <div data-parallax="0.12" class="fixed top-[60%] left-[10%] w-[350px] h-[350px] rounded-full pointer-events-none opacity-[0.10]"
       style="z-index: -18; background: radial-gradient(circle, #06B6D4 0%, transparent 70%);"></div>
  <div data-parallax="0.05" class="fixed top-[35%] left-[50%] w-[500px] h-[500px] rounded-full pointer-events-none opacity-[0.08]"
       style="z-index: -18; background: radial-gradient(circle, #2563EB 0%, transparent 70%);"></div>
  <div data-parallax="0.15" class="fixed top-[80%] right-[30%] w-[250px] h-[250px] rounded-full pointer-events-none opacity-[0.09]"
       style="z-index: -18; background: radial-gradient(circle, #06B6D4 0%, transparent 70%);"></div>

  <!-- Topographic background — simplified -->
  <div class="fixed inset-0 pointer-events-none" style="z-index: -20; opacity: 0.025;">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="topo" width="300" height="300" patternUnits="userSpaceOnUse">
          <path d="M0,150 Q75,100 150,150 Q225,200 300,150" fill="none" stroke="#2563EB" stroke-width="0.8"/>
          <path d="M0,200 Q75,150 150,200 Q225,250 300,200" fill="none" stroke="#2563EB" stroke-width="0.4"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#topo)"/>
    </svg>
  </div>

  <slot />

  <!-- Scripts -->
  <script>
    // ─────────────────────────────────────────────────────────────
    // UNIFIED SCROLL HANDLER — all scroll effects batched in one rAF.
    // This prevents layout thrashing (multiple forced reflows per frame).
    // Technique used by Google Maps, Gmail, etc.
    // ─────────────────────────────────────────────────────────────
    let scrollTicking = false;
    const parallaxEls: { el: HTMLElement; speed: number }[] = [];

    // Cache parallax elements once
    document.querySelectorAll('[data-parallax]').forEach(el => {
      parallaxEls.push({
        el: el as HTMLElement,
        speed: parseFloat((el as HTMLElement).dataset.parallax || '0.08'),
      });
    });

    function onScrollFrame() {
      const scrollY = window.scrollY;

      // 1. Parallax blobs
      for (const { el, speed } of parallaxEls) {
        el.style.transform = `translateY(${scrollY * speed}px)`;
      }

      scrollTicking = false;
    }

    window.addEventListener('scroll', () => {
      if (!scrollTicking) {
        requestAnimationFrame(onScrollFrame);
        scrollTicking = true;
      }
    }, { passive: true });

    // ─────────────────────────────────────────────────────────────
    // SCROLL REVEAL — IntersectionObserver (zero scroll cost)
    // ─────────────────────────────────────────────────────────────
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target); // stop watching after reveal
          }
        });
      },
      { threshold: 0.15 }
    );
    document.querySelectorAll('[data-reveal]').forEach(el => revealObserver.observe(el));

    // ─────────────────────────────────────────────────────────────
    // THEME TOGGLE
    // ─────────────────────────────────────────────────────────────
    const toggle = document.getElementById('theme-toggle');
    toggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateToggleIcon(isDark);
    });
    function updateToggleIcon(isDark: boolean) {
      const sunIcon = document.getElementById('icon-sun');
      const moonIcon = document.getElementById('icon-moon');
      if (sunIcon && moonIcon) {
        sunIcon.style.display = isDark ? 'none' : 'block';
        moonIcon.style.display = isDark ? 'block' : 'none';
      }
    }
    updateToggleIcon(document.documentElement.classList.contains('dark'));

    // ─────────────────────────────────────────────────────────────
    // 3D TILT — only on non-touch devices
    // ─────────────────────────────────────────────────────────────
    if (!window.matchMedia('(hover: none)').matches) {
      document.querySelectorAll('[data-tilt]').forEach(card => {
        const el = card as HTMLElement;
        el.style.transition = 'transform 0.15s ease';
        el.style.transformStyle = 'preserve-3d';
        el.addEventListener('mousemove', (e: Event) => {
          const event = e as MouseEvent;
          const rect = el.getBoundingClientRect();
          const rotateX = (((event.clientY - rect.top) / rect.height) - 0.5) * -12;
          const rotateY = (((event.clientX - rect.left) / rect.width) - 0.5) * 12;
          el.style.transform = `perspective(600px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
          el.style.boxShadow = `${-rotateY}px ${rotateX}px 20px rgba(37,99,235,0.1)`;
        }, { passive: true });
        el.addEventListener('mouseleave', () => {
          el.style.transform = 'perspective(600px) rotateX(0) rotateY(0) scale3d(1, 1, 1)';
          el.style.boxShadow = 'none';
        });
      });
    }

    // ─────────────────────────────────────────────────────────────
    // CANVAS PARTICLE ANIMATION
    // Optimized: 35 particles (was 60), pause when tab hidden,
    // debounced resize, early-exit triangulation
    // ─────────────────────────────────────────────────────────────
    (function initParticles() {
      // Respect reduced-motion preference
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d', { alpha: true });
      const container = document.getElementById('bg-particles');
      if (!container || !ctx) return;

      container.appendChild(canvas);
      canvas.style.width = '100%';
      canvas.style.height = '100%';

      let resizeTimer: ReturnType<typeof setTimeout>;
      function resize() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        }, 200); // debounced 200ms
      }
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      window.addEventListener('resize', resize, { passive: true });

      type ParticleType = 'dot' | 'cross' | 'ring';
      interface Particle {
        x: number; y: number; vx: number; vy: number;
        size: number; opacity: number; type: ParticleType;
      }

      // 35 particles (was 60) — visually equivalent, ~42% less CPU
      const COUNT = 35;
      const types: ParticleType[] = ['dot', 'dot', 'dot', 'cross', 'ring'];
      const particles: Particle[] = Array.from({ length: COUNT }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.3,
        size: Math.random() * 2 + 1,
        opacity: Math.random() * 0.4 + 0.1,
        type: types[Math.floor(Math.random() * types.length)],
      }));

      // 4 contour lines (was 5)
      const contours = Array.from({ length: 4 }, () => ({
        y: Math.random() * canvas.height,
        amplitude: 20 + Math.random() * 40,
        phase: Math.random() * Math.PI * 2,
        opacity: 0.03 + Math.random() * 0.04,
      }));

      const MAX_DIST = 120; // was 140 — fewer connections drawn
      const MAX_DIST_SQ = MAX_DIST * MAX_DIST; // avoid sqrt when possible
      let animId: number;
      let isHidden = false;

      function draw() {
        if (isHidden) return; // pause when tab not visible
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Contour lines
        for (const c of contours) {
          c.phase += 0.003;
          ctx.beginPath();
          const w = canvas.width;
          for (let x = 0; x <= w; x += 6) { // step 6 (was 4) — fewer points
            const y = c.y + Math.sin(x * 0.008 + c.phase) * c.amplitude;
            x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
          }
          ctx.strokeStyle = `rgba(37,99,235,${c.opacity})`;
          ctx.lineWidth = 0.8;
          ctx.stroke();
        }

        // Particles
        const W = canvas.width;
        const H = canvas.height;
        for (const p of particles) {
          p.x = (p.x + p.vx + W) % W;
          p.y = (p.y + p.vy + H) % H;

          ctx.save();
          ctx.globalAlpha = p.opacity;

          if (p.type === 'dot') {
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fillStyle = '#2563EB';
            ctx.fill();
          } else if (p.type === 'cross') {
            const s = p.size * 2;
            ctx.strokeStyle = '#06B6D4';
            ctx.lineWidth = 0.6;
            ctx.beginPath();
            ctx.moveTo(p.x - s, p.y); ctx.lineTo(p.x + s, p.y);
            ctx.moveTo(p.x, p.y - s); ctx.lineTo(p.x, p.y + s);
            ctx.stroke();
          } else {
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size * 2, 0, Math.PI * 2);
            ctx.strokeStyle = '#06B6D4';
            ctx.lineWidth = 0.5;
            ctx.stroke();
            ctx.beginPath();
            ctx.arc(p.x, p.y, 1, 0, Math.PI * 2);
            ctx.fillStyle = '#06B6D4';
            ctx.fill();
          }
          ctx.restore();
        }

        // Triangulation network — use squared distance to skip sqrt
        for (let i = 0; i < COUNT; i++) {
          for (let j = i + 1; j < COUNT; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const distSq = dx * dx + dy * dy;
            if (distSq < MAX_DIST_SQ) {
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.strokeStyle = `rgba(6,182,212,${0.08 * (1 - Math.sqrt(distSq) / MAX_DIST)})`;
              ctx.lineWidth = 0.4;
              ctx.stroke();
            }
          }
        }

        animId = requestAnimationFrame(draw);
      }

      // Pause animation when tab is hidden — saves CPU/battery
      document.addEventListener('visibilitychange', () => {
        isHidden = document.hidden;
        if (!isHidden) animId = requestAnimationFrame(draw);
      });

      animId = requestAnimationFrame(draw);
    })();
  </script>
</body>
</html>
